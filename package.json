    "test:smoke": "python3 tests/smoke.py",
    "assets:fetch": "python3 tools/fetch_assets.py",
    "assets:pack": "node tools/pack_models.mjs"
  },
  "dependencies": {
    "playcanvas": "^2.23.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
